# Supabase project → Settings → API. The anon / publishable key is safe to ship in the app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# MapTiler (maptiler.com → API Keys). Public, but restrict it to your site's
# domains under "Allowed HTTP Origins". Without it the app falls back to
# OpenStreetMap's own servers, which are only for light use.
VITE_MAPTILER_KEY=your-maptiler-key
